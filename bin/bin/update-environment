#!/bin/zsh

DOTFILES_DIR="${HOME}/.local/share/dotfiles"
cd "${DOTFILES_DIR}"
for source in public private ; do
  STOW_DIR="${DOTFILES_DIR}/${source}"
  if [ -d "${STOW_DIR}" ] ; then
    touch "${STOW_DIR}/.stow"
    cd "${STOW_DIR}"
    /usr/bin/git pull --rebase
    /opt/homebrew/bin/stow --dir="${STOW_DIR}" \
                           --target="${HOME}" \
			   --verbose \
			   --restow */
  fi
done
 
